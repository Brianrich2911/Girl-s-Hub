<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#fff8f7" />
  <title>Girl’s｜少女日常内裤</title>
  <style>
    :root {
      --pink: #d98f9d;
      --pink-dark: #b96f7d;
      --pink-light: #fff0f1;
      --cream: #fffaf7;
      --ink: #41383a;
      --muted: #857b7d;
      --white: #fff;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      color: var(--ink);
      background: var(--cream);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
        "Noto Sans SC", "Microsoft YaHei", sans-serif;
    }

    a { color: inherit; text-decoration: none; }

    header {
      padding: 18px 6%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(255,255,255,.92);
      border-bottom: 1px solid #f4e7e6;
    }

    .brand {
      color: var(--pink-dark);
      font-family: Georgia, serif;
      font-size: 27px;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .header-note {
      color: var(--muted);
      font-size: 13px;
    }

    .hero {
      padding: 64px 20px 58px;
      text-align: center;
      background: linear-gradient(135deg, #fff0f1, #fffaf7 72%);
    }

    .hero-label {
      color: var(--pink-dark);
      font-size: 12px;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .hero h1 {
      margin: 14px 0 10px;
      font-family: Georgia, "Noto Serif SC", serif;
      font-size: clamp(32px, 6vw, 52px);
      font-weight: 500;
    }

    .hero p {
      margin: 0 auto;
      max-width: 520px;
      color: var(--muted);
      line-height: 1.8;
    }

    .hero-tag {
      display: inline-block;
      margin-top: 22px;
      padding: 9px 16px;
      border: 1px solid #edc9ce;
      border-radius: 30px;
      color: var(--pink-dark);
      font-size: 14px;
      background: rgba(255,255,255,.7);
    }

    main {
      width: min(1120px, 90%);
      margin: 48px auto 70px;
    }

    .section-heading {
      margin-bottom: 24px;
      text-align: center;
    }

    .section-heading h2 {
      margin: 0 0 8px;
      font-family: Georgia, "Noto Serif SC", serif;
      font-size: 30px;
      font-weight: 500;
    }

    .section-heading p {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }

    .card {
      overflow: hidden;
      border: 1px solid #f2e7e5;
      border-radius: 18px;
      background: var(--white);
      box-shadow: 0 8px 24px rgba(90, 50, 55, .045);
    }

    .product-image {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      background: #f6eeee;
    }

    .card-content { padding: 18px; }

    .product-name {
      min-height: 48px;
      margin: 0 0 9px;
      font-size: 17px;
      line-height: 1.5;
    }

    .description {
      min-height: 42px;
      margin: 0 0 15px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.6;
    }

    .details {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 16px;
    }

    .details span {
      padding: 5px 9px;
      border-radius: 20px;
      color: #806b6f;
      background: #fff4f3;
      font-size: 12px;
    }

    .buy-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .price {
      color: var(--pink-dark);
      font-size: 22px;
      font-weight: 700;
      white-space: nowrap;
    }

    .price small {
      font-size: 12px;
      font-weight: 400;
    }

    .order-button {
      display: inline-block;
      padding: 11px 15px;
      border-radius: 24px;
      color: white;
      background: var(--pink);
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
      transition: background .2s, transform .2s;
    }

    .order-button:hover {
      background: var(--pink-dark);
      transform: translateY(-1px);
    }

    .info {
      margin-top: 42px;
      padding: 24px;
      border-radius: 16px;
      background: #fff0f1;
      text-align: center;
    }

    .info h3 { margin: 0 0 8px; font-size: 17px; }
    .info p {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.8;
    }

    footer {
      padding: 24px 16px;
      color: var(--muted);
      background: white;
      text-align: center;
      font-size: 13px;
    }

    @media (max-width: 760px) {
      .products { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
      .card-content { padding: 14px; }
      .product-name { font-size: 15px; }
      .buy-row { align-items: flex-start; flex-direction: column; }
      .order-button { width: 100%; text-align: center; }
    }

    @media (max-width: 480px) {
      header { padding: 15px 5%; }
      .header-note { font-size: 11px; }
      .hero { padding: 48px 18px; }
      main { width: 92%; margin-top: 36px; }
      .products { gap: 10px; }
      .card-content { padding: 11px; }
      .description { min-height: 58px; font-size: 12px; }
      .details { gap: 5px; }
      .details span { padding: 4px 7px; font-size: 11px; }
      .price { font-size: 19px; }
      .order-button { padding: 10px 8px; font-size: 12px; }
    }
  </style>
</head>
<body>
  <header>
    <a class="brand" href="#">Girl’s</a>
    <span class="header-note">甜甜日常 · 舒适自在</span>
  </header>

  <section class="hero">
    <div class="hero-label">GIRL’S EVERYDAY</div>
    <h1>给日常一点可爱</h1>
    <p>精选少女感日常内裤，简单、舒服，也可以很甜。</p>
    <span class="hero-tag">统一尺码　·　RM9.90 / 件</span>
  </section>

  <main>
    <div class="section-heading">
      <h2>本周精选</h2>
      <p>挑一款喜欢的，点击按钮直接 WhatsApp 询问或下单</p>
    </div>

    <section class="products" id="products"></section>

    <section class="info">
      <h3>尺码与下单说明</h3>
      <p>
        本店商品为统一尺码，售价 RM9.90 每件。<br />
        点击商品下方按钮，可通过 WhatsApp 联系我们确认颜色、库存及配送安排。
      </p>
    </section>
  </main>

  <footer>
    © <span id="year"></span> Girl’s · 商品颜色可能因拍摄光线略有差异
  </footer>

  <script>
    // WhatsApp 使用马来西亚国际号码格式：60 + 手机号码（去掉开头的 0）
    const whatsappNumber = "601169819156";

    const products = [
      {
        name: "日常碎花全棉内裤",
        description: "灰色细碎花设计，柔和简约，适合日常穿着。",
        image: "images/product-1.jpg",
        imageAlt: "灰色碎花女士内裤商品照片",
        tags: ["统一尺码", "碎花款", "RM9.90"]
      },
      {
        name: "蝴蝶结蕾丝三角裤",
        description: "黑色蕾丝花边搭配小蝴蝶结，甜美可爱风格。",
        image: "images/product-2.jpg",
        imageAlt: "黑色蕾丝蝴蝶结女士内裤商品照片",
        tags: ["统一尺码", "蕾丝款", "RM9.90"]
      },
      {
        name: "日系小花花边内裤",
        description: "奶油白底色搭配小花图案与花边，清新温柔。",
        image: "images/product-3.jpg",
        imageAlt: "奶油白小花女士内裤商品照片",
        tags: ["统一尺码", "小花款", "RM9.90"]
      }
    ];

    const productList = document.getElementById("products");

    productList.innerHTML = products.map((product) => {
      const message = `你好，我想询问/购买：${product.name}（RM9.90/件，统一尺码）。请问有货吗？`;
      const whatsappLink =
        `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

      return `
        <article class="card">
          <img
            class="product-image"
            src="${product.image}"
            alt="${product.imageAlt}"
            loading="lazy"
          />
          <div class="card-content">
            <h3 class="product-name">${product.name}</h3>
            <p class="description">${product.description}</p>
            <div class="details">
              ${product.tags.map(tag => `<span>${tag}</span>`).join("")}
            </div>
            <div class="buy-row">
              <div class="price">RM9.90 <small>/ 件</small></div>
              <a
                class="order-button"
                href="${whatsappLink}"
                target="_blank"
                rel="noopener noreferrer"
              >WhatsApp 下单</a>
            </div>
          </div>
        </article>
      `;
    }).join("");

    document.getElementById("year").textContent = new Date().getFullYear();
  </script>
</body>
</html>
